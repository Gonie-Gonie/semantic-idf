{
  "version": 1,
  "rules": [
    {"paths": ["go.mod", "go.sum", "scripts/test*.ps1", "scripts/test*.json", "scripts/toolchain.ps1", "scripts/setup.ps1", "scripts/verify.ps1", "scripts/install-hooks.ps1", "cmd/semantic-idf/app.go", "cmd/semantic-idf/main.go", "cmd/semantic-idf/internal/epinput/*.go", "cmd/semantic-idf/internal/idf/profile.go", "cmd/semantic-idf/internal/idf/profile_apply.go", "cmd/semantic-idf/internal/idf/semantic_navigation.go", "cmd/semantic-idf/internal/idf/semantic_yaml_build.go"], "full": true},
    {"paths": ["cmd/semantic-idf/frontend/src/js/app-info.js"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["tooling"], "description": "release metadata contracts"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/*energy-path*", "cmd/semantic-idf/frontend/src/js/views/energy-path*", "cmd/semantic-idf/frontend/src/styles/energy-path*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks", "./cmd/semantic-idf"], "areas": ["energy-path"], "description": "Energy Path UI and desktop export contracts"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/*hvac*", "cmd/semantic-idf/frontend/src/js/views/hvac*", "cmd/semantic-idf/frontend/src/styles/hvac*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["hvac", "simulation"], "description": "HVAC UI and inspection"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/*topology*", "cmd/semantic-idf/frontend/src/js/views/*topology*", "cmd/semantic-idf/frontend/src/styles/*topology*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["topology"], "description": "Topology UI"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/views/profile*", "cmd/semantic-idf/frontend/src/styles/profile*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["profile"], "description": "Profile UI"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/*simulation*", "cmd/semantic-idf/frontend/src/js/views/*simulation*", "cmd/semantic-idf/frontend/src/js/*comfort*", "cmd/semantic-idf/frontend/src/js/views/*comfort*", "cmd/semantic-idf/frontend/src/js/tools/multi-simulation*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["simulation", "batch"], "description": "Simulation UI and progress"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/batch*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks", "./cmd/semantic-idf"], "areas": ["batch"], "description": "Batch UI and exports"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/*navigation*", "cmd/semantic-idf/frontend/src/js/selection-controller.js", "cmd/semantic-idf/frontend/src/js/view-history.js"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "description": "shared navigation across all UI features"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/views/input*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["input", "navigation"], "description": "Input UI and linked navigation"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/analysis-stage-queue.js", "cmd/semantic-idf/frontend/src/js/views/analysis*"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["analysis", "topology", "profile", "hvac"], "description": "Analysis UI and stage scheduling"},
    {"paths": ["cmd/semantic-idf/frontend/src/js/settings-client.js", "cmd/semantic-idf/frontend/src/settings.html"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["settings"], "description": "Settings UI"},
    {"paths": ["cmd/semantic-idf/frontend/src/*", "cmd/semantic-idf/frontend/assets.go", "cmd/semantic-idf/wails.json"], "packages": ["./cmd/semantic-idf/internal/frontendchecks", "./cmd/semantic-idf"], "description": "shared frontend assets and desktop integration"},
    {"paths": ["cmd/semantic-idf/internal/idf/hvac*.go"], "areas": ["hvac", "energy-path", "navigation"], "description": "shared HVAC analysis, all native allocations and navigation"},
    {"paths": ["cmd/semantic-idf/internal/idf/profile*.go"], "areas": ["profile", "navigation"], "description": "Profile analysis, CLI and linked UI"},
    {"paths": ["cmd/semantic-idf/internal/idf/geometry*.go", "cmd/semantic-idf/internal/idf/thermal*.go"], "areas": ["topology", "profile", "navigation", "simulation-topology", "energy-path", "batch", "export"], "description": "shared geometry, thermal results and all downstream energy consumers"},
    {"paths": ["cmd/semantic-idf/internal/idf/output*.go", "cmd/semantic-idf/internal/idf/simulation_requirements.go"], "areas": ["output", "simulation", "energy-path", "hvac"], "description": "output requests and dependent result readers"},
    {"paths": ["cmd/semantic-idf/internal/idf/semantic*.go"], "areas": ["navigation", "input"], "description": "semantic input and linked navigation"},
    {"paths": ["cmd/semantic-idf/internal/idf/*.go", "cmd/semantic-idf/analysis*.go"], "full": true},
    {"paths": ["cmd/semantic-idf/internal/simulation/energy*.go"], "areas": ["energy-path", "simulation", "export"], "description": "Energy Path backend, SQL oracles and all consumers"},
    {"paths": ["cmd/semantic-idf/internal/simulation/*.go", "cmd/semantic-idf/simulation*.go"], "areas": ["simulation", "energy-path", "hvac", "topology", "batch"], "description": "simulation execution and result consumers"},
    {"paths": ["cmd/semantic-idf/internal/cli/*.go"], "packages": ["./cmd/semantic-idf/internal/cli", "./cmd/semantic-idf"], "description": "CLI and desktop entrypoint"},
    {"paths": ["cmd/semantic-idf/internal/tabular/*.go"], "areas": ["export", "batch"], "description": "spreadsheet exporters and consumers"},
    {"paths": ["cmd/semantic-idf/settings_app.go"], "packages": ["./cmd/semantic-idf", "./cmd/semantic-idf/internal/frontendchecks"], "areas": ["settings"], "description": "settings persistence and UI"},
    {"paths": ["cmd/semantic-idf/batch*.go"], "areas": ["batch", "export"], "description": "batch processing and exporters"},
    {"paths": ["cmd/semantic-idf/energy_path*.go"], "areas": ["energy-path", "export"], "description": "Energy Path adapters and report export"},
    {"paths": ["scripts/release.ps1", "scripts/package.ps1", "scripts/run.ps1", "scripts/check-env.ps1", "scripts/frontend-*.ps1", ".github/workflows/*", "dev.bat"], "packages": ["./cmd/semantic-idf/internal/frontendchecks"], "areas": ["tooling"], "description": "build and release contracts"},
    {"paths": ["docs/agent.md", "docs/testing.md", "docs/README.md", "docs/release-notes/*", "README.md", "CHANGELOG.md", ".gitignore"], "ignore": true},
    {"paths": ["docs/*"], "full": true}
  ]
}
